<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal|top">

    <TextView
        android:id="@+id/textPermissionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:textSize="16sp" />

    <Button
        android:id="@+id/buttonGrantAccess"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="@string/grant_access_button" />

    <Switch
        android:id="@+id/switchMonitoring"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="@string/monitoring_switch_label"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/textEmailCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/textAlarmCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:textSize="18sp" />

    <Button
        android:id="@+id/buttonResetCounters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reset_counters_button" />

    <Button
        android:id="@+id/buttonTestAlarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/test_alarm_button" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_section_title"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editThreshold"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:hint="@string/threshold_hint"
        android:inputType="number"
        android:maxLength="3" />

    <EditText
        android:id="@+id/editWindowSeconds"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/window_hint"
        android:inputType="number"
        android:maxLength="5" />

    <Button
        android:id="@+id/buttonSaveSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/save_settings_button" />

</LinearLayout>
